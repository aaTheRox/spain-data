---
interface Props {
  href: string;
  /** Texto del enlace. Debe describir el destino: nunca «clic aquí». */
  label: string;
  /** Fuente de la que procede el enlace, para construir un texto legible. */
  sourceName?: string;
}

const { href, label, sourceName } = Astro.props;
---

<a
  class="group inline-flex items-center gap-2 text-[0.95rem] text-ink-soft transition-colors duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-ink"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span
    class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent-soft text-accent-ink transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px"
  >
    <svg
      width="11"
      height="11"
      viewBox="0 0 16 16"
      aria-hidden="true"
      focusable="false"
      class="block"
    >
      <path
        d="M6 3h7v7M13 3 4.5 11.5M11.5 13H3V4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="underline decoration-rule-strong underline-offset-[0.22em] transition-colors duration-300 group-hover:decoration-ink">
    {label}
  </span>
  {sourceName && <span class="sr-only"> ({sourceName})</span>}
  <span class="sr-only">(se abre en una pestaña nueva)</span>
</a>