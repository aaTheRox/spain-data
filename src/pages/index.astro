---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import ChartExplorer from '../components/ChartExplorer.astro';
import IndicatorExplorer from '../components/IndicatorExplorer.astro';
import Balance from '../components/Balance.astro';
import Timeline from '../components/Timeline.astro';
import Sparkline from '../components/Sparkline.astro';
import SourceLink from '../components/SourceLink.astro';
import TrendTag from '../components/TrendTag.astro';
import { getPublishedIndicators, formatNumber } from '../lib/indicators';
import { DATA_REVIEWED_AT } from '../data/indicators';
import { SITE, PENDING } from '../data/site';

const indicators = getPublishedIndicators();
const unemployment = indicators.find((indicator) => indicator.id === 'tasa-paro');
const youth = indicators.find((indicator) => indicator.id === 'paro-juvenil');
const debt = indicators.find((indicator) => indicator.id === 'deuda-publica');
const poverty = indicators.find((indicator) => indicator.id === 'riesgo-pobreza');

const reviewLabel = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(
  new Date(DATA_REVIEWED_AT),
);

/* Cifra protagonista: la primera y la que más se lee. */
const headline = unemployment;

/* Cifras de apoyo, en una columna estrecha a la derecha del bloque tipográfico. */
const supporting = [youth, debt, poverty].filter(
  (indicator): indicator is NonNullable<typeof indicator> => Boolean(indicator),
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'es',
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.maintainer,
    url: SITE.url,
  },
  ...indicators.map((indicator) => ({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: indicator.title,
    description: indicator.summary,
    creator: { '@type': 'Organization', name: indicator.source.name },
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'text/html',
        contentUrl: indicator.source.url,
      },
    ],
    temporalCoverage: `${indicator.baselineLabel}/${indicator.currentLabel}`,
    dateModified: DATA_REVIEWED_AT,
    variableMeasured: indicator.unit,
  })),
];
---

<BaseLayout
  title="Indicadores oficiales de España desde el 1 de junio de 2018"
  description={SITE.description}
  path="/"
  structuredData={structuredData}
>
  <SiteChrome path="/">
    <!--
      Composición asimétrica 7/5. Antes el titular y el lede ocupaban como
      mucho la mitad izquierda y los primeros 1400 px de scroll dejaban la
      mitad derecha vacía. Ahora la derecha lleva el dato, que es lo que el
      visitante viene a ver.
    -->
    <section
      class="page-shell grid gap-x-16 gap-y-14 pt-[clamp(3rem,9vh,6rem)] pb-[calc(var(--spacing-section)*0.45)] lg:grid-cols-12"
      aria-labelledby="titulo-principal"
    >
      <div class="lg:col-span-7">
        <p class="eyebrow mb-8">España · datos oficiales · desde 2018</p>

        <h1 id="titulo-principal" class="text-hero max-w-[14ch]">
          Ocho años de España, cifra a cifra
        </h1>

        <p class="mt-8 max-w-[46ch] text-lede text-ink-soft">
          Catorce indicadores oficiales de empleo, precios, vivienda, energía y finanzas públicas,
          comparados entre el primer dato anterior a junio de 2018 y el último publicado. Cada
          cifra lleva su periodo exacto, su unidad y el enlace a la serie de origen.
        </p>

        <p class="mt-8 max-w-[52ch] text-[0.95rem] leading-relaxed text-muted">
          Punto de partida: <strong class="font-semibold text-ink-soft">1 de junio de 2018</strong>,
          fecha de la moción de censura al Gobierno de Mariano Rajoy.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a class="button button-solid" href="#explorador">
            Explorar los catorce indicadores
            <span class="button-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a class="button" href="/metodologia/">Cómo se comparan</a>
        </div>
      </div>

      <!-- Panel de dato: la serie protagonista con su contexto. -->
      {
        headline && (
          <div class="lg:col-span-5">
            <div class="plate plate-lift">
              <div class="plate-core p-7">
                <p class="text-[0.625rem] tracking-[0.16em] uppercase text-muted">
                  {headline.title}
                </p>

                <p class="mt-4 font-display text-[4.25rem] leading-none tracking-tight tabular-nums">
                  {formatNumber(headline.currentValue, headline.decimals)}
                  <span class="ml-1 text-[1.5rem] text-muted">%</span>
                </p>

                <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.95rem] text-muted">
                  <span>{headline.currentLabel}</span>
                  <TrendTag indicator={headline} />
                </p>

                <div class="mt-7">
                  <Sparkline
                    points={headline.series.es}
                    markerPeriod="2018-06"
                    label={`${headline.title} de enero de 2018 a julio de 2026`}
                    unit="%"
                    height={112}
                  />
                </div>

                <!--
                  Se queda en dos columnas en todo el ancho. El panel ocupa
                  5/12 de la retícula, así que incluso a 1024 px mide ~345 px:
                  con tres columnas, «PERIODO INICIAL» partía en dos líneas y
                  «% de la población activa» en tres. El breakpoint tiene que
                  seguir el ancho del panel, no el del viewport.
                -->
                <dl
                  class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-rule pt-5"
                >
                  <div class="min-w-0">
                    <dt class="text-[0.625rem] tracking-[0.14em] uppercase text-muted">
                      Periodo inicial
                    </dt>
                    <dd class="mt-1.5 font-mono text-[1.25rem] tabular-nums text-ink-soft">
                      {formatNumber(headline.baselineValue, headline.decimals)}
                    </dd>
                    <dd class="text-[0.6875rem] text-muted">{headline.baselineLabel}</dd>
                  </div>
                  <div class="min-w-0">
                    <dt class="text-[0.625rem] tracking-[0.14em] uppercase text-muted">
                      Variación
                    </dt>
                    <dd class="mt-1.5 font-mono text-[1.25rem] tabular-nums text-rise">
                      {headline.change.absoluteLabel}
                    </dd>
                  </div>
                  <div class="col-span-2 min-w-0">
                    <dt class="text-[0.625rem] tracking-[0.14em] uppercase text-muted">Unidad</dt>
                    <dd class="mt-1.5 text-[0.95rem] leading-snug text-ink-soft">
                      % de la población activa
                    </dd>
                  </div>
                </dl>

                <p class="mt-6">
                  <SourceLink
                    href={headline.source.url}
                    label={`Serie completa en ${headline.source.name.split('—')[0]?.trim()}`}
                    sourceName={headline.source.name}
                  />
                </p>

                <p class="mt-4 border-t border-rule pt-4 text-[0.75rem] leading-relaxed text-muted">
                  Datos revisados el {reviewLabel}. Todas las series proceden de Eurostat. No se
                  publica ninguna estimación: los indicadores sin serie comparable quedan fuera y
                  se explican.
                </p>
              </div>
            </div>

            <dl class="mt-5 grid gap-4 xl:grid-cols-3">
              {supporting.map((indicator) => (
                <a
                  class="min-w-0 rounded-card border border-rule bg-surface/50 p-4 no-underline transition-[border-color,background-color] duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-rule-strong hover:bg-surface"
                  href={`/indicadores/${indicator.id}/`}
                >
                  <dt class="text-[0.6875rem] leading-tight text-muted">{indicator.title}</dt>
                  <dd class="mt-2 font-mono text-[1.5rem] leading-none tabular-nums text-ink">
                    {formatNumber(indicator.currentValue, indicator.decimals)}
                  </dd>
                  <dd class="mt-1.5 text-[0.6875rem] text-muted">{indicator.currentLabel}</dd>
                </a>
              ))}
            </dl>
          </div>
        )
      }
    </section>

    <IndicatorExplorer indicators={indicators} />

    <!--
      Comparativa en filas a ancho completo. Con catorce tarjetas de dos
      columnas, las barras de 8 px ocupaban el 4 % de la altura de cada una y la
      comparación no se leía. Ahora cada indicador ocupa una fila y la barra
      es el elemento principal: gris para el periodo inicial, acento para el
      actual. El color codifica el dato, no decora.
    -->
    <section class="page-shell section-block" id="comparativa">
      <div class="section-head title-measure">
        <p class="eyebrow">Comparativa de periodos</p>
        <h2 class="text-title">Dos puntos, y todo lo que hay entre ellos</h2>
        <p class="text-lede text-muted">
          Cada fila compara el periodo inicial y el actual de un indicador, con su fecha exacta.
          La escala de cada barra es independiente: no se comparan magnitudes de unidades
          distintas entre sí.
        </p>
      </div>

      <div class="hidden border-b border-rule pb-3 text-[0.625rem] tracking-[0.14em] uppercase text-muted lg:grid lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)_8rem_8rem] lg:gap-x-6">
        <span>Indicador</span>
        <span>Periodo inicial → actual</span>
        <span class="text-right">Inicial</span>
        <span class="text-right">Actual</span>
      </div>

      <ol class="m-0 list-none p-0">
        {
          indicators.map((indicator) => {
            const max =
              Math.max(Math.abs(indicator.baselineValue), Math.abs(indicator.currentValue)) || 1;
            const basePct = (Math.abs(indicator.baselineValue) / max) * 100;
            const nowPct = (Math.abs(indicator.currentValue) / max) * 100;

            return (
              <li class="grid gap-x-6 gap-y-4 border-b border-rule py-5 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)_8rem_8rem] lg:items-center">
                <div class="min-w-0">
                  <a
                    class="font-display text-[1.15rem] leading-snug text-ink no-underline decoration-transparent underline-offset-[0.2em] transition-colors duration-300 hover:underline hover:decoration-accent"
                    href={`/indicadores/${indicator.id}/`}
                  >
                    {indicator.title}
                  </a>
                  <p class="mt-1 text-[0.75rem] text-muted">{indicator.unit}</p>
                </div>

                <div class="grid gap-2.5">
                  <div class="flex items-center gap-3">
                    <span class="w-24 shrink-0 text-[0.6875rem] text-muted lg:hidden">
                      {indicator.baselineLabel}
                    </span>
                    <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-surface-raised">
                      <span
                        class="block h-full rounded-full bg-rule-strong transition-[width] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                        style={`width:${basePct}%`}
                      />
                    </span>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="w-24 shrink-0 text-[0.6875rem] text-muted lg:hidden">
                      {indicator.currentLabel}
                    </span>
                    <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-surface-raised">
                      <span
                        class="block h-full rounded-full bg-rise transition-[width] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                        style={`width:${nowPct}%`}
                      />
                    </span>
                  </div>
                </div>

                <p class="text-right font-mono text-[1.05rem] tabular-nums text-muted">
                  {formatNumber(indicator.baselineValue, indicator.decimals)}
                </p>
                <p class="text-right font-mono text-[1.15rem] tabular-nums text-ink">
                  {formatNumber(indicator.currentValue, indicator.decimals)}
                </p>
              </li>
            );
          })
        }
      </ol>
    </section>

    <ChartExplorer indicators={indicators} />

    <Balance indicators={indicators} />

    <Timeline />

    <section class="page-shell section-block">
      <div class="section-head title-measure">
        <p class="eyebrow">Sobre el proyecto</p>
        <h2 class="text-title">Quién mantiene la página y cómo corregirla</h2>
        <p class="text-lede text-muted">
          {SITE.maintainer}. Las cifras se incrustan en la compilación del sitio: no se hace
          scraping en el navegador ni se guardan datos de terceros en el cliente. Cada número se ha
          comprobado contra la serie oficial antes de publicar.
        </p>
        <p class="max-w-[68ch] text-[0.95rem] leading-relaxed text-muted">
          Si una cifra está mal, si una fuente ha cambiado o si una serie ya no es comparable,
          escríbenos a <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. Las
          correcciones se aplican en la siguiente revisión, con la fecha de cambio visible en{' '}
          <a href="/actualizacion.xml">el registro de actualización</a>. {PENDING.length} indicadores
          quedan fuera de forma deliberada, con el motivo declarado en la{' '}
          <a href="#balance">sección de retos</a>.
        </p>
      </div>
    </section>
  </SiteChrome>
</BaseLayout>
